Ref: reference.status_codes.id < runtime.execution_plan_processes.status_code_id
Ref: metadata.project_processes.id < runtime.execution_watermark_controls.project_process_id
Ref: metadata.project_tables.id < runtime.execution_watermark_controls.table_id
Ref: metadata.project_columns.id < runtime.execution_watermark_controls.watermark_column_id
Ref: metadata.projects.id < runtime.execution_runs.project_id
