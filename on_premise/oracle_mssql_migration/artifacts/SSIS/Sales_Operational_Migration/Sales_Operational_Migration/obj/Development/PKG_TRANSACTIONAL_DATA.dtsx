    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{E8B874AD-AFF8-47B4-8B37-A7ABD43861D7}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="REPLACE(REPLACE(&quot;SELECT&#xA;    SALESORDERID,&#xA;    REVISIONNUMBER,&#xA;    ORDERDATE,&#xA;    DUEDATE,&#xA;    SHIPDATE,&#xA;    STATUS,&#xA;    ONLINEORDERFLAG,&#xA;    SALESORDERNUMBER,&#xA;    PURCHASEORDERNUMBER,&#xA;    ACCOUNTNUMBER,&#xA;    CUSTOMERID,&#xA;    SALESPERSONID,&#xA;    TERRITORYID,&#xA;    BILLTOADDRESSID,&#xA;    SHIPTOADDRESSID,&#xA;    SHIPMETHODID,&#xA;    CREDITCARDID,&#xA;    CREDITCARDAPPROVALCODE,&#xA;    CURRENCYRATEID,&#xA;    SUBTOTAL,&#xA;    TAXAMT,&#xA;    FREIGHT,&#xA;    TOTALDUE,&#xA;    COMMENT&#xA;FROM ADVENTUREWORKS2022.SALES_SALESORDERHEADER&#xA;WHERE ORDERDATE &gt;= TO_DATE({1}, 'YYYY-MM-DD HH24:MI:SS') &#xA;AND ORDERDATE &lt; TO_DATE({2}, 'YYYY-MM-DD HH24:MI:SS');&quot;, &quot;{1}&quot;, @[User::v_batch_start_value] ), &quot;{2}&quot;,  @[User::v_batch_end_value])"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="v_query_SALES_SALESORDERHEADER">
      <DTS:VariableValue
        DTS:DataType="8">SELECT
    SALESORDERID,
    REVISIONNUMBER,
    ORDERDATE,
    DUEDATE,
    SHIPDATE,
    STATUS,
    ONLINEORDERFLAG,
    SALESORDERNUMBER,
    PURCHASEORDERNUMBER,
    ACCOUNTNUMBER,
    CUSTOMERID,
    SALESPERSONID,
    TERRITORYID,
    BILLTOADDRESSID,
    SHIPTOADDRESSID,
    SHIPMETHODID,
    CREDITCARDID,
    CREDITCARDAPPROVALCODE,
    CURRENCYRATEID,
    SUBTOTAL,
    TAXAMT,
    FREIGHT,
    TOTALDUE,
    COMMENT
FROM ADVENTUREWORKS2022.SALES_SALESORDERHEADER
WHERE ORDERDATE &gt;= TO_DATE(2011-05-01 00:00:00, 'YYYY-MM-DD HH24:MI:SS') 
AND ORDERDATE &lt; TO_DATE(2011-05-31 23:59:59, 'YYYY-MM-DD HH24:MI:SS');</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
