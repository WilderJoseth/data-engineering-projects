                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    p."BUSINESSENTITYID",
    p."PERSONTYPE",
    p."TITLE",
    p."FIRSTNAME",
    p."MIDDLENAME",
    p."LASTNAME"
FROM ADVENTUREWORKS2022.PERSON_PERSON p
