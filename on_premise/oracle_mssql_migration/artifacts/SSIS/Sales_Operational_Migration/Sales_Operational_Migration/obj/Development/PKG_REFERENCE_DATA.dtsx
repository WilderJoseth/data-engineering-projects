      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{248B846D-257D-4960-B092-2545A0A85847}"
          SQLTask:SqlStatementSource="SELECT&#xA;    MAX(IIF([table_id] = 19 AND [execution_required] = 1, 1, 0))  AS AddressType_load_execution_required,&#xA;    MAX(IIF([table_id] = 19 AND [execution_required] = 1, [process_child_id], NULL)) AS AddressType_load_id&#xA;FROM [metadata].[ufn_list_project_process_tables](?, ?, 0);"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="AddressType_load_execution_required"
            SQLTask:DtsVariableName="User::v_AddressType_load_execution_required" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="AddressType_load_id"
            SQLTask:DtsVariableName="User::v_AddressType_load_id" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::p_project_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="2"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::v_reference_data_load_id"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
